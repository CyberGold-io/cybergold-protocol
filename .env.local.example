# Local protocol development fixture only.
# Canonical ops env policy lives in ../cybergold-ops/env/.
# Copy to .env.local for direct product-repo work. Never commit .env.local.

# Upstream mainnet RPC for forked anvil (can include provider tokens).
MAINNET_RPC_URL=https://ethereum.publicnode.com
# Directory for per-run Anvil logs.
ANVIL_LOG_DIR=/tmp

# Local fork chain id (use non-mainnet to avoid wallet cache/network collisions).
ANVIL_CHAIN_ID=31337

# Deployer private key for live deployments (no fallback). Fork/local scripts
# always use the default Anvil dev key, even if this is set. Never commit real keys.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Safe salt nonce for deterministic deployment.
SAFE_SALT_NONCE=1
SAFE_EXPECTED_ADDRESS=0x0000000000000000000000000000000000000000

# mainnet-fork-deploy.sh defaults protocol admin/guardian/allocator to Safe.
# Set to 0 to disable.
FORK_USE_SAFE_ROLES=1

# Inline role wiring in DeployProtocol. In Safe-role mode, keep this unset or 0;
# the deploy script will wire roles afterwards by impersonating the Safe on Anvil.
DEPLOY_AUTO_WIRE_ROLES=0
