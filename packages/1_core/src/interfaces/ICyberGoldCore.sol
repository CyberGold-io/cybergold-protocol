    /// @return orderedBasketAssets Exact ordered basket asset identity used by this calculation.
    /// @custom:facet preview
    function previewIssueFromBasketExactOut(uint256 netCygldOut)
        external
        view
        returns (uint256 protocolFeeCygld, uint256[] memory amountsInExact, address[] memory orderedBasketAssets);
    /// @notice Preview the complete canonical mixed output vector for an exact gross CYGLD input.
    /// @dev Redemption fees are caller-sensitive; set `eth_call.from` to the future Core caller.
    /// @param grossCygldIn Exact gross CYGLD input to quote.
    /// @return quote Current projected outputs and protocol fee.
    /// @custom:facet preview
    function previewRedeemExactIn(uint256 grossCygldIn)
        external
        view
        returns (ICoreRedemption.RedemptionQuote memory quote);
    /// @notice Preview the minimum gross CYGLD input satisfying a complete canonical minimum vector.
    /// @dev Redemption fees are caller-sensitive; set `eth_call.from` to the future Core caller.
    /// @param minimumOutputs Complete canonical output identities and per-output minima.
    /// @return quote Minimum gross input and its current projected outputs and protocol fee.
    /// @custom:facet preview
    function previewRedeemExactOut(ICoreRedemption.TokenMinimum[] calldata minimumOutputs)
        external
        view
        returns (ICoreRedemption.RedemptionQuote memory quote);

    // ---------- basketAdmin facet ----------
    /// @notice Set basket.
    /// @param currentBasketHash Caller-expected hash of the current basket arrays.
    /// @param assets_ Basket asset addresses to configure.
    /// @param targetsPpm_ Basket target weights in parts per million.
    /// @param goldRefGramsFp18_ Asset gold reference amounts in 18-decimal fixed point.
    /// @custom:facet basketAdmin
    function setBasket(
        bytes32 currentBasketHash,
        address[] calldata assets_,
        uint256[] calldata targetsPpm_,
        uint256[] calldata goldRefGramsFp18_
    ) external;

    // ---------- controllerConfig facet ----------
    /// @notice Maximum protocol fee in parts per million.
    /// @custom:facet controllerConfig
    function MAX_FEE_PPM() external view returns (uint256 result0);
    /// @notice Role exempted from redemption fee collection.
    /// @custom:facet controllerConfig
    function REDEMPTION_FEE_EXEMPT_ROLE() external view returns (bytes32 result0);
    /// @notice Set the issuance fee in parts per million.
    /// @param currentIssuanceFeePpm Caller-supplied current issuance fee rate in parts per million.
    /// @param newIssuanceFeePpm Replacement issuance fee rate in parts per million.
    /// @custom:facet controllerConfig
    function setIssuanceFeePpm(uint256 currentIssuanceFeePpm, uint256 newIssuanceFeePpm) external;
    /// @notice Set max total supply.
    /// @param currentMaxTotalSupply Caller-expected current maximum CYGLD total supply.
    /// @param newMaxTotalSupply Proposed replacement maximum CYGLD total supply.
    /// @custom:facet controllerConfig
    function setMaxTotalSupply(uint256 currentMaxTotalSupply, uint256 newMaxTotalSupply) external;
    /// @notice Set the redemption fee in parts per million.
    /// @param currentRedemptionFeePpm Caller-supplied current redemption fee rate in parts per million.
    /// @param newRedemptionFeePpm Replacement redemption fee rate in parts per million.
    /// @custom:facet controllerConfig
    function setRedemptionFeePpm(uint256 currentRedemptionFeePpm, uint256 newRedemptionFeePpm) external;
    /// @notice Set treasury.
    /// @param currentTreasury Caller-expected current treasury address.
    /// @param newTreasury Proposed replacement treasury address.
    /// @custom:facet controllerConfig
    function setTreasury(address currentTreasury, address newTreasury) external;

    // ---------- lens facet ----------
    /// @notice Return basket assets.
    /// @return result0 Ordered basket asset addresses.
    /// @custom:facet lens
    function basketAssets() external view returns (address[] memory result0);
    /// @notice Return the canonical expected-current hash of the basket arrays.
    /// @return result0 Hash of basket assets, target weights and gold reference arrays.
    /// @custom:facet lens
    function basketConfigHash() external view returns (bytes32 result0);
    /// @notice Return basket CYGLD per unit fp18.
    /// @return result0 Per-asset CYGLD conversion rates in 18-decimal fixed point.
    /// @custom:facet lens
    function basketCygldPerUnitFp18() external view returns (uint256[] memory result0);
    /// @notice Return basket gold ref grams fp18.
    /// @return result0 Per-asset gold reference amounts in 18-decimal fixed point.
    /// @custom:facet lens
    function basketGoldRefGramsFp18() external view returns (uint256[] memory result0);
    /// @notice Return basket targets PPM.
    /// @return result0 Target basket weights in parts per million.
    /// @custom:facet lens
    function basketTargetsPpm() external view returns (uint256[] memory result0);
    /// @notice Return the ordered assets with positive Core-attached recovery exposure.
    /// @return assets Current economic recovery assets in canonical order.
    /// @custom:facet lens
    function coreAttachedRecoveryAssets() external view returns (address[] memory assets);
    /// @notice Return CYGLD ref grams fp18.
    /// @return result0 CYGLD gold reference amount in 18-decimal fixed point.
    /// @custom:facet lens
    function cygldRefGramsFp18() external view returns (uint256 result0);
    /// @notice Return the current CYGLD supply ceiling derived from all live impairment terms.
    /// @return cygldSupplyCap Current effective CYGLD supply ceiling.
    /// @custom:facet lens
    function effectiveCygldSupplyCap() external view returns (uint256 cygldSupplyCap);
    /// @notice Return the issuance fee in parts per million.
    /// @return result0 Current issuance fee rate in parts per million.
    /// @custom:facet lens
    function issuanceFeePpm() external view returns (uint256 result0);
    /// @notice Return the configured maximum CYGLD total supply.
    /// @return result0 Maximum CYGLD total supply configured for controlled launch.
    /// @custom:facet lens
    function maxTotalSupply() external view returns (uint256 result0);
    /// @notice Return the number of assets with any outstanding recovery right.
    /// @return count Number of current outstanding assets.
    /// @custom:facet lens
    function outstandingRecoveryAssetCount() external view returns (uint256 count);
    /// @notice Read a bounded page; order may change after a mutation, so pin all pages to one block.
    /// @param offset Zero-based position in the current outstanding set.
    /// @param limit Maximum number of returned entries, between one and 64.
    /// @return assets Outstanding asset identities in this page.
    /// @return nextOffset Next offset, or the current count at the end.
    /// @custom:facet lens
    function outstandingRecoveryAssets(uint256 offset, uint256 limit)
        external
        view
        returns (address[] memory assets, uint256 nextOffset);
    /// @notice Preview pro-rata original-asset proceeds for external recovery shares.
    /// @dev Impaired mode shares capped live custody with Core; healthy mode uses reserved liability. Unreadable custody reverts, whereas an observed zero returns zero without burning shares.
    /// @param asset Original asset identifying the permanent pool.
    /// @param shares Recovery-share amount to price.
    /// @return rawOut Raw original-asset proceeds under current pool accounting.
    /// @custom:facet lens
    function previewRedeemRecoveryShares(address asset, uint256 shares) external view returns (uint256 rawOut);
    /// @notice Return current recovery-pool state for an asset.
    /// @dev A nonzero asset without a pool returns the default all-zero current state.
    /// @param asset Asset identifying the recovery pool.
    /// @return viewData Current pool accounting and external ERC-1155 supply.
    /// @custom:facet lens
    function recoveryPool(address asset) external view returns (IRecoveryTypes.RecoveryPoolView memory viewData);
    /// @notice Return redemption fee PPM.
    /// @return result0 Current redemption fee rate in parts per million.
    /// @custom:facet lens
    function redemptionFeePpm() external view returns (uint256 result0);
    /// @notice Return lifecycle-aware custody and obligation accounting for an asset.
    /// @param asset Reserve or recovery-pool asset to inspect.
    /// @return status Current book state plus an explicitly fallible live custody observation.
    /// @custom:facet lens
    function reserveCustodyStatus(address asset)
        external
        view
        returns (IRecoveryTypes.ReserveCustodyStatus memory status);
    /// @notice Return current reserve lifecycle state for an asset.
    /// @dev A nonzero asset without lifecycle state returns the default all-zero view.
    /// @param asset Reserve asset to inspect.
    /// @return viewData Current lifecycle record.
    /// @custom:facet lens
    function reserveLifecycle(address asset) external view returns (IRecoveryTypes.ReserveLifecycleView memory viewData);
    /// @notice Return treasury.
    /// @return result0 Treasury address receiving protocol fees.
    /// @custom:facet lens
    function treasury() external view returns (address result0);

    // ---------- reserveLifecycle facet ----------
    /// @notice Activate a reserve from the request's exact current lifecycle and basket state.
    /// @param request Expected source state and complete resulting basket.
    /// @custom:facet reserveLifecycle
    function activateAsset(IRecoveryTypes.AssetActivationRequest calldata request) external;
    /// @notice Begin a planned reserve exit from the exact current active state.
    /// @param request Expected current entitlement and complete resulting basket.
    /// @custom:facet reserveLifecycle
    function beginReserveExit(IRecoveryTypes.ReserveExitRequest calldata request) external;
    /// @notice Finalize a drained, obligation-free exiting reserve as inactive.
    /// @param request Expected current basket and complete resulting basket.
    /// @custom:facet reserveLifecycle
    function finalizeReserveInactivation(IRecoveryTypes.ReserveInactivationRequest calldata request) external;

    // ---------- recoveryShare facet ----------
    /// @dev Returns the value of tokens of token type `id` owned by `account`.
    /// @custom:facet recoveryShare
    function balanceOf(address account, uint256 id) external view returns (uint256 result0);
    /// @dev See {IERC1155-balanceOfBatch}. Requirements: - `accounts` and `ids` must have the same length.
    /// @custom:facet recoveryShare
    function balanceOfBatch(address[] calldata accounts, uint256[] calldata ids)
        external
        view
        returns (uint256[] memory result0);
    /// @notice Burn asset-scoped recovery shares through a guarded Core self-call.
    /// @param from Account whose ERC-1155 balance is reduced.
    /// @param asset Impaired asset identifying the permanent recovery pool.
    /// @param amount Recovery-share amount burned.
    /// @custom:facet recoveryShare
    function burnRecoveryShares(address from, address asset, uint256 amount) external;
    /// @dev Returns true if `operator` is approved to transfer ``account``'s tokens. See {setApprovalForAll}.
    /// @custom:facet recoveryShare
    function isApprovedForAll(address account, address operator) external view returns (bool result0);
    /// @notice Issue one strictly asset-ordered batch through a guarded Core self-call.
    /// @param to Account receiving the ERC-1155 shares.
    /// @param assets Strictly ascending impaired assets identifying the permanent pools.
    /// @param amounts Share amounts minted for the corresponding assets.
    /// @custom:facet recoveryShare
    function issueRecoveryShares(address to, address[] calldata assets, uint256[] calldata amounts) external;
    /// @dev xref:ROOT:erc1155.adoc#batch-operations[Batched] version of {safeTransferFrom}. WARNING: This function can potentially allow a reentrancy attack when transferring tokens to an untrusted contract, when invoking {IERC1155Receiver-onERC1155BatchReceived} on the receiver. Ensure to follow the checks-effects-interactions pattern and consider employing reentrancy guards when interacting with untrusted contracts. Emits either a {TransferSingle} or a {TransferBatch} event, depending on the length of the array arguments. Requirements: - `ids` and `values` must have the same length. - If `to` refers to a smart contract, it must implement {IERC1155Receiver-onERC1155BatchReceived} and return the acceptance magic value.
    /// @custom:facet recoveryShare
    function safeBatchTransferFrom(
        address from,
        address to,
        uint256[] calldata ids,
        uint256[] calldata values,
        bytes calldata data
    ) external;
    /// @dev Transfers a `value` amount of tokens of type `id` from `from` to `to`. WARNING: This function can potentially allow a reentrancy attack when transferring tokens to an untrusted contract, when invoking {IERC1155Receiver-onERC1155Received} on the receiver. Ensure to follow the checks-effects-interactions pattern and consider employing reentrancy guards when interacting with untrusted contracts. Emits a {TransferSingle} event. Requirements: - `to` cannot be the zero address. - If the caller is not `from`, it must have been approved to spend ``from``'s tokens via {setApprovalForAll}. - `from` must have a balance of tokens of type `id` of at least `value` amount. - If `to` refers to a smart contract, it must implement {IERC1155Receiver-onERC1155Received} and return the acceptance magic value.
    /// @custom:facet recoveryShare
    function safeTransferFrom(address from, address to, uint256 id, uint256 value, bytes calldata data) external;
    /// @dev Grants or revokes permission to `operator` to transfer the caller's tokens, according to `approved`, Emits an {ApprovalForAll} event. Requirements: - `operator` cannot be the zero address.
    /// @custom:facet recoveryShare
    function setApprovalForAll(address operator, bool approved) external;
    /// @notice Return the external ERC-1155 supply for a recovery-share identifier.
    /// @param shareId Canonical ERC-1155 recovery-share identifier.
    /// @return supply External fungible share supply held outside Core accounting.
    /// @custom:facet recoveryShare
    function totalSupply(uint256 shareId) external view returns (uint256 supply);

    // ---------- recoveryShareMetadata facet ----------
    /// @notice Return this chain and Core deployment's deterministic collection metadata URL.
    /// @return result0 HTTPS URL ending in `/collection.json`.
    /// @custom:facet recoveryShareMetadata
    function contractURI() external view returns (string memory result0);
    /// @notice Return one known asset recovery pool's deterministic token-type metadata URL.
    /// @param shareId Canonical address-derived ERC-1155 recovery-share identifier.
    /// @return result0 HTTPS URL ending in the decimal `shareId` plus `.json`.
    /// @custom:facet recoveryShareMetadata
    function uri(uint256 shareId) external view returns (string memory result0);

    // ---------- recoveryAdmin facet ----------
    /// @notice Activate recovery accounting from the request's exact current lifecycle and basket state.
    /// @param request Expected source state, resulting basket, and impairment-time CYGLD total-supply cap.
    /// @custom:facet recoveryAdmin
    function activateRecovery(IRecoveryTypes.RecoveryActivation calldata request) external;
    /// @notice Finalize a zero-entitlement impairment without changing the Inactive lifecycle.
    /// @param asset Impaired asset whose current zero-entitlement state is finalized.
    /// @custom:facet recoveryAdmin
    function finalizeZeroEntitlementRecovery(address asset) external;
    /// @notice Reserve capped external claims and restore ordinary backing to a validated Active basket.
    /// @param request Expected source state, resulting basket, and minimum raw allocations.
    /// @custom:facet recoveryAdmin
    function rehabilitateRecoveryAsset(IRecoveryTypes.RecoveryRehabilitation calldata request) external;

    // ---------- recoveryPoolSettlement facet ----------
    /// @notice Burn external shares for a pro-rata payment from a redeemable original-asset pool.
    /// @param asset Original impaired asset held in the recovery pool.
    /// @param shares Recovery-share amount burned from the caller.
    /// @param recipient Account receiving original-asset proceeds.
    /// @param minRawOut Minimum acceptable raw original-asset proceeds.
    /// @return rawOut Exact raw original-asset amount transferred.
    /// @custom:facet recoveryPoolSettlement
    function redeemRecoveryShares(address asset, uint256 shares, address recipient, uint256 minRawOut)
        external
        returns (uint256 rawOut);
}
