    function name() external view returns (string memory result0);
    /// @notice Burn processed escrow shares and pay their current underlying value.
    /// @dev Callable only by another installed Diamond facet. The second positional argument records the request owner at call sites but is not used for ERC-4626 accounting or event identity.
    /// @param controller Queue controller reported as the ERC-4626 withdrawal owner.
    /// @param receiver Account receiving the underlying payout.
    /// @param shares Exact escrowed Staking shares burned for the payout.
    /// @return assetsOut Underlying amount transferred to `receiver`.
    /// @custom:facet vault
    function payout(address controller, address arg1, address receiver, uint256 shares)
        external
        returns (uint256 assetsOut);
    /// @dev Allows an on-chain or off-chain user to simulate the effects of their deposit at the current block, given current on-chain conditions. - MUST return as close to and no more than the exact amount of Vault shares that would be minted in a deposit call in the same transaction. I.e. deposit should return the same or more shares as previewDeposit if called in the same transaction. - MUST NOT account for deposit limits like those returned from maxDeposit and should always act as though the deposit would be accepted, regardless if the user has enough tokens approved, etc. - MUST be inclusive of deposit fees. Integrators should be aware of the existence of deposit fees. - MUST NOT revert. NOTE: any unfavorable discrepancy between convertToShares and previewDeposit SHOULD be considered slippage in share price or some other type of condition, meaning the depositor will lose assets by depositing.
    /// @custom:facet vault
    function previewDeposit(uint256 assets) external view returns (uint256 result0);
    /// @dev Allows an on-chain or off-chain user to simulate the effects of their mint at the current block, given current on-chain conditions. - MUST return as close to and no fewer than the exact amount of assets that would be deposited in a mint call in the same transaction. I.e. mint should return the same or fewer assets as previewMint if called in the same transaction. - MUST NOT account for mint limits like those returned from maxMint and should always act as though the mint would be accepted, regardless if the user has enough tokens approved, etc. - MUST be inclusive of deposit fees. Integrators should be aware of the existence of deposit fees. - MUST NOT revert. NOTE: any unfavorable discrepancy between convertToAssets and previewMint SHOULD be considered slippage in share price or some other type of condition, meaning the depositor will lose assets by minting.
    /// @custom:facet vault
    function previewMint(uint256 shares) external view returns (uint256 result0);
    /// @notice Preview redeem.
    /// @return result0 Unavailable because redemption previewing is queue-mediated.
    /// @custom:facet vault
    function previewRedeem(uint256 arg0) external pure returns (uint256 result0);
    /// @notice Preview withdraw.
    /// @return result0 Unavailable because withdrawal previewing is queue-mediated.
    /// @custom:facet vault
    function previewWithdraw(uint256 arg0) external pure returns (uint256 result0);
    /// @notice Release escrowed shares from the vault back to a request owner after cancellation or expiry.
    /// @param owner Account receiving the returned shares.
    /// @param shares Escrowed share amount to release.
    /// @custom:facet vault
    function returnShares(address owner, uint256 shares) external;
    /// @dev Returns the symbol of the token, usually a shorter version of the name.
    /// @custom:facet vault
    function symbol() external view returns (string memory result0);
    /// @notice Return idle underlying plus claimable queue liquidity and healthy sleeve-managed assets.
    /// @return assets Total underlying assets managed by the vault.
    /// @custom:facet vault
    function totalAssets() external view returns (uint256 assets);
    /// @notice Return total assets with a health flag instead of reverting on sleeve query failure.
    /// @return assets Total underlying assets counted when sleeve accounting is healthy.
    /// @return healthy Whether fund manager and sleeve accounting are currently healthy.
    /// @custom:facet vault
    function totalAssetsSafe() external view returns (uint256 assets, bool healthy);
    /// @dev Returns the value of tokens in existence.
    /// @custom:facet vault
    function totalSupply() external view returns (uint256 result0);
    /// @notice Transfer Staking shares while rejecting direct user-funded Diamond escrow.
    /// @param to Recipient of the Staking shares.
    /// @param value Exact Staking share amount transferred.
    /// @return result0 Whether the share transfer succeeded.
    /// @custom:facet vault
    function transfer(address to, uint256 value) external returns (bool result0);
    /// @notice Spend an allowance to transfer Staking shares while rejecting direct user-funded Diamond escrow.
    /// @param from Share holder whose allowance and balance are spent.
    /// @param to Recipient of the Staking shares.
    /// @param value Exact Staking share amount transferred.
    /// @return result0 Whether the allowance-backed share transfer succeeded.
    /// @custom:facet vault
    function transferFrom(address from, address to, uint256 value) external returns (bool result0);

    // ---------- queue facet ----------
    /// @notice Cancel one request and return its remaining escrow shares, including while paused.
    /// @dev Automatic promotion is skipped while paused so cancellation cannot advance unrelated requests.
    /// @param requestId Queue request identifier.
    /// @return sharesReturned Shares returned to the owner after cancellation or expiry.
    /// @custom:facet queue
    function cancelRequest(uint256 requestId) external returns (uint256 sharesReturned);
    /// @notice Claim an entire ready request and send its underlying payout.
    /// @param requestId Queue request identifier.
    /// @param receiver Underlying recipient; zero defaults to the request owner.
    /// @return assetsOut Underlying asset amount paid out for redeemed vault shares.
    /// @custom:facet queue
    function claimRequest(uint256 requestId, address receiver) external returns (uint256 assetsOut);
    /// @notice Claim as much of a ready request as fits within an underlying-asset ceiling.
    /// @param requestId Queue request identifier.
    /// @param maxAssets Maximum underlying value to settle.
    /// @param receiver Underlying recipient; zero defaults to the request owner.
    /// @return assetsOut Underlying asset amount paid out for redeemed vault shares.
    /// @custom:facet queue
    function claimRequestUpTo(uint256 requestId, uint256 maxAssets, address receiver)
        external
        returns (uint256 assetsOut);
    /// @notice Promote affordable open requests to claimable status while Staking is unpaused.
    /// @param maxRequests Maximum number of requests to promote.
    /// @return processed Number of queue requests processed.
    /// @custom:facet queue
    function processQueue(uint256 maxRequests) external returns (uint256 processed);
    /// @notice Remove the selected expired requests and return their escrow shares.
    /// @param requestIds Request identifiers checked for expiry and removal.
    /// @return expiredCount Number of expired queue requests found.
    /// @custom:facet queue
    function purgeExpired(uint256[] calldata requestIds) external returns (uint256 expiredCount);
    /// @notice Consume ready requests for a controller and redeem an exact aggregate share amount.
    /// @param shares Exact claimable Staking shares to burn.
    /// @param receiver Account receiving the underlying payout.
    /// @param owner Queue controller whose claimable requests are consumed.
    /// @return assetsOut Underlying asset amount paid out for redeemed vault shares.
    /// @custom:facet queue
    function redeem(uint256 shares, address receiver, address owner) external returns (uint256 assetsOut);
    /// @notice Escrow Staking shares and append an asynchronous redemption request.
    /// @param shares Exact Staking shares moved from `owner` into Diamond escrow.
    /// @param controller Account that controls settlement and owns the claimable aggregate; zero defaults to `owner`.
    /// @param owner Share holder funding the request.
    /// @return requestId Queue request identifier assigned by the queue.
    /// @custom:facet queue
    function requestRedeem(uint256 shares, address controller, address owner) external returns (uint256 requestId);
    /// @notice Set the maximum requests automatically promoted after an eligible user flow.
    /// @param newLimit Replacement automatic-promotion bound; zero disables automatic promotion.
    /// @custom:facet queue
    function setAutoProcessMax(uint256 newLimit) external;
    /// @notice Set the elapsed time after promotion during which a request remains claimable.
    /// @param expirySeconds Queue claim-expiry duration in seconds.
    /// @custom:facet queue
    function setClaimExpiry(uint64 expirySeconds) external;
    /// @notice Set the maximum number of expired head requests swept by one queue operation.
    /// @param newLimit Replacement expired-head sweep bound.
    /// @custom:facet queue
    function setHeadSweepLimit(uint256 newLimit) external;
    /// @notice Remove up to `max` consecutively expired requests from the queue head.
    /// @param max Maximum number of expired head requests to remove.
    /// @return purged Number of expired queue requests purged.
    /// @custom:facet queue
    function sweepExpiredHead(uint256 max) external returns (uint256 purged);
    /// @notice Withdraw an exact underlying amount by rounding up and redeeming the controller's ready shares.
    /// @param assets Exact underlying amount requested.
    /// @param receiver Account receiving the underlying payout.
    /// @param owner Queue controller whose claimable requests are consumed.
    /// @return sharesBurned Shares burned while finalizing a request.
    /// @custom:facet queue
    function withdraw(uint256 assets, address receiver, address owner) external returns (uint256 sharesBurned);

    // ---------- queueOperator facet ----------
    /// @notice Grant or revoke another account's authority to settle the caller's queue requests.
    /// @param operator Account receiving or losing settlement authority.
    /// @param approved Whether the delegation is enabled.
    /// @custom:facet queueOperator
    function setControllerOperator(address operator, bool approved) external;
    /// @notice Grant or revoke another account's authority to create redemption requests for the caller.
    /// @param operator Account receiving or losing request-creation authority.
    /// @param approved Whether the delegation is enabled.
    /// @custom:facet queueOperator
    function setOwnerOperator(address operator, bool approved) external;

    // ---------- queueSig facet ----------
    /// @notice EIP-712 domain separator (for off-chain signers/tests).
    /// @return result0 EIP-712 domain separator for this staking diamond and chain.
    /// @custom:facet queueSig
    function DOMAIN_SEPARATOR() external view returns (bytes32 result0);
    /// @notice EIP-712 typehash for signed redeem requests.
    /// @custom:facet queueSig
    function REQUEST_REDEEM_TYPEHASH() external view returns (bytes32 result0);
    /// @notice Return the next EIP-712 redemption-request nonce for an owner.
    /// @param owner Share owner whose nonce is queried.
    /// @return result0 Current signed-request nonce for `owner`.
    /// @custom:facet queueSig
    function nonces(address owner) external view returns (uint256 result0);
    /// @notice Relay an owner's signed instruction to escrow shares and append a redemption request.
    /// @param shares Exact Staking shares moved from `owner` into Diamond escrow.
    /// @param controller Account controlling settlement; zero defaults to `owner`.
    /// @param owner Share holder who signed and funds the request.
    /// @param deadline Last timestamp at which the signed request remains valid.
    /// @param v ECDSA recovery id from the queue signature.
    /// @param r ECDSA r value from the queue signature.
    /// @param s ECDSA s value from the queue signature.
    /// @return requestId Queue request identifier assigned by the queue.
    /// @custom:facet queueSig
    function requestRedeemBySig(
        uint256 shares,
        address controller,
        address owner,
        uint256 deadline,
        uint8 v,
        bytes32 r,
        bytes32 s
    ) external returns (uint256 requestId);

    // ---------- custody facet ----------
    /// @notice Configured withdrawer role.
    /// @custom:facet custody
    function WITHDRAWER_ROLE() external view returns (bytes32 result0);
    /// @notice Returns the balance of `token` held by the custody (diamond) address.
    /// @param token ERC20 token checked against custody balance.
    /// @return result0 Balance of the token held by the custody address.
    /// @custom:facet custody
    function custodyBalance(address token) external view returns (uint256 result0);
    /// @notice Custodial transfer to a recipient, callable by authorized withdrawers.
    /// @param token ERC20 token transferred out of custody.
    /// @param to Recipient receiving the custodial transfer.
    /// @param amount Token amount transferred from custody.
    /// @custom:facet custody
    function transferTo(address token, address to, uint256 amount) external;

    // ---------- registry facet ----------
    /// @notice Register a Staking-controlled Sleeve, or change its asset binding only at zero principal.
    /// @param sleeve Sleeve adapter to register.
    /// @param asset Expected underlying token reported by the Sleeve.
    /// @custom:facet registry
    function registerSleeve(address sleeve, address asset) external;
    /// @notice Enable or disable new allocations to a registered Sleeve.
    /// @param sleeve Registered Sleeve whose allocation eligibility changes.
    /// @param approved Whether new allocations are permitted.
    /// @custom:facet registry
    function setSleeveApproval(address sleeve, bool approved) external;
    /// @notice Return the registry and principal-accounting state for one Sleeve.
    /// @param sleeve Sleeve address to query.
    /// @return cfg Registration, approval, underlying, and book-principal state.
    /// @custom:facet registry
    function sleeveConfig(address sleeve) external view returns (SleeveConfig memory cfg);
    /// @notice Return every Sleeve in registry insertion order.
    /// @return result0 Registered Sleeve addresses.
    /// @custom:facet registry
    function sleeves() external view returns (address[] memory result0);
    /// @notice Aggregated sleeve-held assets for the provided underlying token.
    /// @param asset Underlying asset whose registered sleeve balances are aggregated.
    /// @return total Total assets held across registered sleeves for the requested asset.
    /// @custom:facet registry
    function stakerAssetsInSleeves(address asset) external view returns (uint256 total);

    // ---------- fund facet ----------
    /// @notice Role authorized to allocate and deallocate sleeve assets.
    /// @custom:facet fund
    function ALLOCATOR_ROLE() external view returns (bytes32 result0);
    /// @notice Maximum performance fee: 10% in parts per million.
    /// @custom:facet fund
    function MAX_PERFORMANCE_FEE_PPM() external view returns (uint256 result0);
    /// @notice Allocate custody assets to an approved sleeve within staking-backed capacity.
    /// @dev Increases both per-sleeve and per-asset book principal by the sleeve-reported amount actually used.
    /// @param sleeve Registered and approved sleeve to operate.
    /// @param assets Maximum underlying amount requested for deployment.
    /// @param data Venue-specific allocation constraints forwarded to the sleeve.
    /// @return used Underlying amount the sleeve actually deployed.
    /// @custom:facet fund
    function allocate(address sleeve, uint256 assets, bytes calldata data) external returns (uint256 used);
    /// @notice Return the Core diamond address used as the CYGLD token and reserve.
    /// @return result0 CYGLD/Core diamond address.
    /// @custom:facet fund
    function cygld() external view returns (address result0);
    /// @notice Deallocate, including while the staking diamond is paused for emergency unwinds.
    /// @param sleeve Registered sleeve to unwind.
    /// @param assets Maximum underlying amount requested from the sleeve.
    /// @param data Venue-specific unwind constraints forwarded to the sleeve.
    /// @return returned Underlying amount returned to Staking custody.
    /// @custom:facet fund
    function deallocate(address sleeve, uint256 assets, bytes calldata data) external returns (uint256 returned);
    /// @notice Realize sleeve profit, convert it to CYGLD, pay the Governance fee, and retain the remainder for stakers.
    /// @param sleeve Registered sleeve whose profit is harvested.
    /// @param minCygldOut Minimum total CYGLD accepted after any required conversion.
    /// @param data Venue-specific harvest and slippage constraints forwarded to the sleeve.
    /// @return profitAssets Underlying profit amount realized by the sleeve.
    /// @return cygldOut Total CYGLD received by the Staking Diamond.
    /// @return feeCygld CYGLD transferred to the configured Governance treasury.
    /// @return donatedCygld CYGLD retained by the Staking Diamond for the benefit of stakers.
    /// @custom:facet fund
    function harvestAndDonateAsCygld(address sleeve, uint256 minCygldOut, bytes calldata data)
        external
        returns (uint256 profitAssets, uint256 cygldOut, uint256 feeCygld, uint256 donatedCygld);
    /// @notice Max investable backing for `asset` per the staking sleeve, minus principal already allocated.
    /// @param asset Basket backing asset checked for available sleeve staking capacity.
    /// @return result0 Investable asset amount after custody, claimable, and principal accounting.
    /// @custom:facet fund
    function investableFor(address asset) external view returns (uint256 result0);
    /// @notice Return the fraction of converted profit paid to treasury.
    /// @return result0 Performance fee in parts per million.
    /// @custom:facet fund
    function performanceFeePpm() external view returns (uint256 result0);
    /// @notice Return a registered sleeve's book principal, current value, and signed profit or loss.
    /// @param sleeve Registered sleeve to inspect.
    /// @return asset Underlying token assigned to the sleeve.
    /// @return principalAssets Book principal tracked for the sleeve in underlying units.
    /// @return totalAssets Current underlying-equivalent assets reported by the sleeve.
    /// @return pnl Signed sleeve profit or loss in underlying asset units.
    /// @custom:facet fund
    function position(address sleeve)
        external
        view
        returns (address asset, uint256 principalAssets, uint256 totalAssets, int256 pnl);
    /// @notice Return aggregate book principal deployed across all sleeves for one asset.
    /// @param asset Underlying asset to query.
    /// @return result0 Deployed principal in the asset's smallest unit.
    /// @custom:facet fund
    function principalPerAsset(address asset) external view returns (uint256 result0);
    /// @notice Atomically replace the performance fee if storage still matches the expected current value.
    /// @param currentPerformanceFeePpm Expected stored fee in parts per million.
    /// @param newFeePpm Replacement fee in parts per million, capped at 100,000 (10%).
    /// @custom:facet fund
    function setPerformanceFee(uint256 currentPerformanceFeePpm, uint256 newFeePpm) external;
    /// @notice Set the adapter used to convert harvested non-CYGLD underlying into CYGLD.
    /// @param adapter Swap adapter address checked or configured for routed swaps.
    /// @custom:facet fund
    function setSwapAdapter(address adapter) external;
    /// @notice Set the account that receives the performance-fee share of harvested CYGLD.
    /// @param treasury_ Treasury address receiving protocol or fund-manager proceeds.
    /// @custom:facet fund
    function setTreasury(address treasury_) external;
    /// @notice Return the fraction of total CYGLD supply represented by staking-vault assets.
    /// @return ratioFp18 Staked CYGLD supply ratio in 18-decimal fixed-point units, rounded down.
    /// @custom:facet fund
    function stakerRatioFp18() external view returns (uint256 ratioFp18);
    /// @notice Return the adapter configured for harvested-profit conversion.
    /// @return result0 Swap adapter address, or zero when conversion is unavailable.
    /// @custom:facet fund
    function swapAdapter() external view returns (address result0);
    /// @notice Return the account receiving performance fees from harvested profit.
    /// @return result0 Performance-fee treasury address.
    /// @custom:facet fund
    function treasury() external view returns (address result0);

    // ---------- lens facet ----------
    /// @notice Return the maximum requests automatically promoted by an eligible user flow.
    /// @return result0 Maximum queue requests auto-processed in one call.
    /// @custom:facet lens
    function autoProcessMax() external view returns (uint256 result0);
    /// @notice Return the elapsed seconds after promotion during which requests remain claimable.
    /// @return result0 Queue claim expiry duration in seconds.
    /// @custom:facet lens
    function claimExpiry() external view returns (uint64 result0);
    /// @notice Return a controller's aggregate claimable shares for the ERC-7540 aggregate sentinel.
    /// @dev Only `requestId == 0` denotes the aggregate request; every other identifier returns zero.
    /// @param requestId Aggregate request identifier, which must be zero.
    /// @param controller Queue controller to query.
    /// @return shares Aggregate processed Staking shares claimable by `controller`.
    /// @custom:facet lens
    function claimableRedeemRequest(uint256 requestId, address controller) external view returns (uint256 shares);
    /// @notice Return the aggregate Staking shares currently claimable by a controller.
    /// @param controller Queue controller to query.
    /// @return result0 Processed Staking shares claimable by `controller`.
    /// @custom:facet lens
    function claimableShares(address controller) external view returns (uint256 result0);
    /// @notice Return the Staking shares currently claimable across every controller.
    /// @return result0 Total vault shares claimable from processed queue requests.
    /// @custom:facet lens
    function claimableSharesTotal() external view returns (uint256 result0);
    /// @notice Return all open request identifiers indexed to a queue controller.
    /// @param controller Queue controller to query.
    /// @return ids Open request identifiers in controller-index order.
    /// @custom:facet lens
    function controllerOpenQueries(address controller) external view returns (uint256[] memory ids);
    /// @notice Return a bounded page of open request identifiers indexed to a queue controller.
    /// @param controller Queue controller to query.
    /// @param start Zero-based index of the first controller request to return.
    /// @param limit Maximum request identifiers returned.
    /// @return ids Selected open request identifiers in controller-index order.
    /// @return total Total open requests indexed to `controller`.
    /// @return nextStart Cursor immediately after the returned page.
    /// @custom:facet lens
    function controllerOpenQueries(address controller, uint256 start, uint256 limit)
        external
        view
        returns (uint256[] memory ids, uint256 total, uint256 nextStart);
    /// @notice Decode a request's creation timestamp from its identifier.
    /// @param id Queue request identifier.
    /// @return result0 Timestamp encoded in the queue request id.
    /// @custom:facet lens
    function createdAt(uint256 id) external pure returns (uint64 result0);
    /// @notice Return the first linked request identifier, or zero for an empty queue.
    /// @return result0 Current queue head request id.
    /// @custom:facet lens
    function headId() external view returns (uint256 result0);
    /// @notice Return the maximum expired head requests swept by one queue operation.
    /// @return result0 Maximum queue head entries swept in one maintenance pass.
    /// @custom:facet lens
    function headSweepLimit() external view returns (uint256 result0);
    /// @notice Return whether a ready request has passed its configured claim window.
    /// @param id Queue request identifier.
    /// @return result0 Whether the queue request claim window has expired.
    /// @custom:facet lens
    function isExpired(uint256 id) external view returns (bool result0);
    /// @notice Return whether an existing request is within the promoted ready boundary.
    /// @param id Queue request identifier.
    /// @return result0 Whether the queue request is ready to claim.
    /// @custom:facet lens
    function isReady(uint256 id) external view returns (bool result0);
    /// @notice Return queue boundaries, limits, sequence, and global/controller claimable totals.
    /// @param controller Queue controller whose claimable-share total is included.
    /// @return agg Current queue aggregate snapshot.
    /// @custom:facet lens
    function queueAggregates(address controller) external view returns (QueueAggregates memory agg);
    /// @notice Return complete views for every open request indexed to a controller.
    /// @param controller Queue controller to query.
    /// @return out All open requests indexed for the controller, in index order.
    /// @custom:facet lens
    function queueRequests(address controller) external view returns (QueueRequestView[] memory out);
    /// @notice Return the promotion timestamp retained for a request.
    /// @param id Queue request identifier.
    /// @return result0 Timestamp when the queue request becomes claimable.
    /// @custom:facet lens
    function readyAtFor(uint256 id) external view returns (uint64 result0);
    /// @notice Return the highest linked request identifier promoted to claimable status.
    /// @return result0 Highest queue request id marked ready.
    /// @custom:facet lens
    function readyBoundaryId() external view returns (uint256 result0);
    /// @notice Return the sequence assigned to the latest request created in the current block.
    /// @return result0 Sequence number used to order queue requests within a block.
    /// @custom:facet lens
    function seqInBlock() external view returns (uint64 result0);
    /// @notice Return current principal, value, PnL, and approval for every registered Sleeve.
    /// @return positions Sleeve snapshots in registry insertion order.
    /// @custom:facet lens
    function sleevePositions() external view returns (SleevePosition[] memory positions);
    /// @notice Return the terminal launch phase and authenticated finalization hash.
    /// @dev This selector is installed only as part of the committed production finalization.
    /// @return phase Current atomic-launch phase.
    /// @return finalizationHash Hash of the exact candidate that finalized the Diamond.
    /// @custom:facet lens
    function stakingLaunchState() external view returns (uint8 phase, bytes32 finalizationHash);
    /// @notice Return the Staking underlying, global pause flag, and last recorded fund-manager health.
    /// @return s Current asset, pause policy, and fund-manager health.
    /// @custom:facet lens
    function systemState() external view returns (SystemState memory s);
    /// @notice Return the final linked request identifier, or zero for an empty queue.
    /// @return result0 Current queue tail request id.
    /// @custom:facet lens
    function tailId() external view returns (uint256 result0);
    /// @notice Introspect a specific queue request.
    /// @param id Queue request id to inspect.
    /// @return controller Controller address associated with the request.
    /// @return owner Owner address associated with the request.
    /// @return shares Share amount recorded on the request.
    /// @return createdAtTs Timestamp when the request was created.
    /// @return readyAtTs Timestamp when the request becomes ready.
    /// @return ready Whether the request is ready to claim.
    /// @return expired Whether the request has passed its claim expiry.
    /// @return assetsAtCurrentPrice Current asset value represented by the queued shares.
    /// @return paused_ Whether the staking vault is currently paused.
    /// @return healthy Compatibility health field; currently always true and not a live fund-manager health probe.
    /// @return claimable Whether the request can be claimed now.
    /// @custom:facet lens
    function viewRequest(uint256 id)
        external
        view
        returns (
            address controller,
            address owner,
            uint256 shares,
            uint64 createdAtTs,
            uint64 readyAtTs,
            bool ready,
            bool expired,
            uint256 assetsAtCurrentPrice,
            bool paused_,
            bool healthy,
            bool claimable
        );
}
